{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blackout-watch/schemas/incident",
  "title": "Incident",
  "type": "object",
  "required": ["id", "title", "category", "severity", "status", "published_at", "updated_at", "reports", "affected", "score"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "summary": {"type": "string", "maxLength": 2000},
    "category": {"type": "string", "enum": ["electricity", "cables", "finance", "cyber", "logistics", "geopolitics"]},
    "secondary_categories": {"type": "array", "items": {"type": "string", "enum": ["electricity", "cables", "finance", "cyber", "logistics", "geopolitics"]}},
    "subtype": {"type": ["string", "null"]},
    "severity": {"type": "integer", "minimum": 1, "maximum": 5},
    "status": {"type": "string", "enum": ["confirmed", "probable", "unverified", "denied", "resolved"]},
    "is_ongoing": {"type": "boolean"},
    "published_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"},
    "duration_hours": {"type": ["number", "null"]},
    "demo": {"type": "boolean"},
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "tier", "owner", "url", "title", "published_at"],
        "properties": {
          "source_id": {"type": "string"},
          "tier": {"type": "string", "enum": ["A", "B", "C", "D"]},
          "owner": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "published_at": {"type": "string", "format": "date-time"},
          "raw_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "affected": {
      "type": "object",
      "properties": {
        "countries": {"type": "array", "items": {"type": "string"}},
        "regions": {"type": "array", "items": {"type": "string"}},
        "zones": {"type": "array", "items": {"type": "string"}},
        "infrastructure_type": {"type": "string", "enum": ["national", "regional", "local", "non_critical"]},
        "importance": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "origin": {
      "type": "object",
      "properties": {
        "countries": {"type": "array", "items": {"type": "string"}},
        "attribution": {"type": "string", "enum": ["official", "press_allegation", "none"]},
        "threat_actor": {"type": ["string", "null"]},
        "coordinated_campaign": {"type": "boolean"}
      }
    },
    "score": {
      "type": "object",
      "properties": {
        "by_zone": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "value": {"type": "number", "minimum": 0, "maximum": 100},
              "factors": {"type": "object"}
            }
          }
        }
      }
    },
    "confidence": {
      "type": "object",
      "properties": {
        "n_owners": {"type": "integer"},
        "max_tier": {"type": "string"},
        "K": {"type": "number"}
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "field", "from", "to"],
        "properties": {
          "timestamp": {"type": "string", "format": "date-time"},
          "field": {"type": "string"},
          "from": {},
          "to": {}
        }
      }
    },
    "classification": {
      "type": "object",
      "properties": {
        "ai_suggestion": {
          "type": ["object", "null"],
          "properties": {
            "category": {"type": "string"},
            "subtype": {"type": "string"},
            "summary": {"type": "string"},
            "model": {"type": "string"},
            "timestamp": {"type": "string", "format": "date-time"}
          }
        }
      }
    }
  }
}
