{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://blackout-watch/schemas/sources",
  "title": "SourcesStatus",
  "type": "object",
  "required": ["checked_at", "sources"],
  "properties": {
    "checked_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "status": {"type": "string", "enum": ["ok", "error", "not_tested", "disabled"]},
          "http_status": {"type": ["integer", "null"]},
          "content_type": {"type": ["string", "null"]},
          "parse_ok": {"type": ["boolean", "null"]},
          "items_count": {"type": ["integer", "null"]},
          "last_item_date": {"type": ["string", "null"]},
          "error_message": {"type": ["string", "null"]},
          "latency_ms": {"type": ["number", "null"]}
        }
      }
    }
  }
}
